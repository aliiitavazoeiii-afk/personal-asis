# Copy to .env. NEVER commit .env or put an API key in Android assets.
APP_PASSWORD=CHANGE_TO_LONG_PRIVATE_PASSWORD
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
OPENAI_API_KEY=
DEFAULT_TZ=Asia/Tehran
COOKIE_SECURE=true
TRANSCRIBE_MODEL=gpt-4o-transcribe
PARSE_MODEL=gpt-4.1-mini

# Optional: do not enable until a private 32+ character token is configured.
# Generate a new random token on the server; never commit its value.
MCP_API_TOKEN=
MCP_ALLOWED_HOSTS=asis.filmjadiid.ir
